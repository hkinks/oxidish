!runs/vision/export/vision_m7a_final.json
!runs/vision/export/vision_p6.onnx
!runs/vision/export/vision_p6.json
target/
target-*/

# raw match rows (large, regenerable)
runs/ab_*.json
runs/verdict_*.json
